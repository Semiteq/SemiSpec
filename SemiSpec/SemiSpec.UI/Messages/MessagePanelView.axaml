<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:messages="clr-namespace:SemiSpec.UI.Messages"
             xmlns:text="clr-namespace:SemiSpec.UI.Localization"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="160"
             x:Class="SemiSpec.UI.Messages.MessagePanelView"
             x:DataType="messages:MessagePanelViewModel">

    <UserControl.Styles>
        <Style Selector="Ellipse.severity-error">
            <Setter Property="Fill" Value="{DynamicResource AppSeverityErrorBrush}" />
        </Style>
        <Style Selector="Ellipse.severity-warning">
            <Setter Property="Fill" Value="{DynamicResource AppSeverityWarningBrush}" />
        </Style>
        <Style Selector="Ellipse.severity-info">
            <Setter Property="Fill" Value="{DynamicResource AppSeverityInfoBrush}" />
        </Style>
    </UserControl.Styles>

    <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,0,0,4">

            <TextBlock Text="{x:Static text:Resources.MessagePanelTitle}"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />

            <Button Name="ClearMessages"
                    Content="{x:Static text:Resources.MessagePanelClear}"
                    Command="{Binding ClearCommand}" />

        </StackPanel>

        <!-- One three-line entry; a taller cap pushes the chart floors past a 1366 x 768 screen. -->
        <ScrollViewer MaxHeight="64"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Name="MessageEntries"
                          ItemsSource="{Binding Entries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="messages:MessageEntry">
                        <Grid ColumnDefinitions="Auto,Auto,*"
                              Margin="0,4">

                            <Ellipse Grid.Column="0"
                                     Name="EntrySeverity"
                                     Width="8"
                                     Height="8"
                                     Margin="0,4,8,0"
                                     VerticalAlignment="Top"
                                     Classes.severity-error="{Binding View.Severity, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static messages:MessageSeverity.Error}}"
                                     Classes.severity-warning="{Binding View.Severity, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static messages:MessageSeverity.Warning}}"
                                     Classes.severity-info="{Binding View.Severity, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static messages:MessageSeverity.Info}}" />

                            <TextBlock Grid.Column="1"
                                       Name="EntryTime"
                                       Text="{Binding LastSeen, StringFormat={}{0:HH:mm:ss}}"
                                       Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Top" />

                            <StackPanel Grid.Column="2">
                                <TextBlock Name="EntryTitle"
                                           Text="{Binding View.Title}"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap" />
                                <TextBlock Name="EntryRepeat"
                                           Text="{Binding RepeatCount, StringFormat={x:Static text:Resources.MessagePanelRepeatFormat}}"
                                           IsVisible="{Binding HasRepeated}"
                                           Foreground="{DynamicResource AppSecondaryForegroundBrush}" />
                                <TextBlock Name="EntryDetail"
                                           Text="{Binding View.Detail}"
                                           TextWrapping="Wrap" />
                                <TextBlock Name="EntryRemedy"
                                           Text="{Binding View.Remedy}"
                                           IsVisible="{Binding View.Remedy, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
