<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SemiSpec.UI.Spectrum"
             xmlns:text="clr-namespace:SemiSpec.UI.Localization"
             mc:Ignorable="d"
             d:DesignWidth="312"
             d:DesignHeight="220"
             x:Class="SemiSpec.UI.Spectrum.SpectrumPanel"
             x:DataType="local:SpectrumViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <!-- The readout of the shown spectrum; 120 px is the number width. -->
    <Grid ColumnSpacing="12"
          RowSpacing="8"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto"
                              MinWidth="120" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Name="DeviceLabel"
                   Text="{x:Static text:Resources.SignalDevice}" />
        <TextBlock Grid.Row="0"
                   Grid.Column="1"
                   Name="DeviceValue"
                   Text="{Binding SignalInfo.SpectrometerText}" />

        <TextBlock Grid.Row="1"
                   Name="WavelengthLabel"
                   Text="{x:Static text:Resources.SignalWavelength}" />
        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Name="WavelengthValue"
                   Text="{Binding SignalInfo.WavelengthText}" />

        <TextBlock Grid.Row="2"
                   Name="WindowLabel"
                   Text="{x:Static text:Resources.SignalWindow}" />
        <TextBlock Grid.Row="2"
                   Grid.Column="1"
                   Name="WindowValue"
                   Text="{Binding SignalInfo.WindowText}" />

        <TextBlock Grid.Row="3"
                   Name="AmplitudeLabel"
                   Text="{x:Static text:Resources.SignalAmplitude}" />
        <TextBlock Grid.Row="3"
                   Grid.Column="1"
                   Name="AmplitudeValue"
                   Text="{Binding SignalInfo.AmplitudeText}" />

        <TextBlock Grid.Row="4"
                   Name="SnrLabel"
                   Text="{x:Static text:Resources.SignalSnr}" />
        <TextBlock Grid.Row="4"
                   Grid.Column="1"
                   Name="SnrValue"
                   Text="{Binding SignalInfo.SnrText}" />

        <TextBlock Grid.Row="5"
                   Name="QLabel"
                   Text="{x:Static text:Resources.SignalQ}" />
        <TextBlock Grid.Row="5"
                   Grid.Column="1"
                   Name="QValue"
                   Text="{Binding SignalInfo.QText}" />

        <TextBlock Grid.Row="6"
                   Name="UpdatedLabel"
                   Text="{x:Static text:Resources.SignalUpdated}" />
        <TextBlock Grid.Row="6"
                   Grid.Column="1"
                   Name="UpdatedValue"
                   Text="{Binding SignalInfo.UpdatedText}" />
    </Grid>

</UserControl>
