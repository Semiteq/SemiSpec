<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SemiSpec.UI.MainWindow"
        xmlns:messages="clr-namespace:SemiSpec.UI.Messages"
        xmlns:spectrum="clr-namespace:SemiSpec.UI.Spectrum"
        xmlns:text="clr-namespace:SemiSpec.UI.Localization"
        xmlns:trend="clr-namespace:SemiSpec.UI.Trend"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="800"
        x:Class="SemiSpec.UI.MainWindow.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="{x:Static text:Resources.WindowTitle}"
        Width="{x:Static local:MainWindow.OpeningWidth}"
        Height="800"
        MinWidth="{x:Static local:MainWindow.MinimumWidth}"
        MinHeight="{x:Static local:MainWindow.MinimumHeight}"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <local:AppMenuBar Grid.Row="0"
                          Name="MenuBar" />

        <Border Grid.Row="1"
                Name="ConnectionRow"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Padding="16,8">
            <!-- SemiPlot keeps its live-navigation buttons in the top bar; here they follow the connection row. -->
            <StackPanel Orientation="Horizontal"
                        Spacing="16">
                <local:ConnectionBar DataContext="{Binding ConnectionBar}" />
                <Border Name="LiveSeparator"
                        Width="1"
                        Height="24"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AppBorderBrush}" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Name="BackToLive"
                            Content="{x:Static text:Resources.ChartBackToLive}"
                            Command="{Binding Spectrum.BackToLiveCommand}" />
                    <Button Name="FollowLive"
                            Content="{x:Static text:Resources.TrendFollowLive}"
                            Command="{Binding Trend.FollowLiveCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- The readout sits beside the spectrum only; the trend and the overview span the full width. -->
        <Grid Grid.Row="2"
              Name="ContentArea"
              ColumnDefinitions="*,Auto">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"
                               MinHeight="{x:Static local:MainWindow.SpectrumRowMinHeight}" />
                <RowDefinition Height="2*"
                               MinHeight="{x:Static local:MainWindow.TrendRowMinHeight}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- No padding: ScottPlot draws its own axis margins over the panel background. -->
            <Border Grid.Row="0"
                    Grid.Column="0"
                    Name="SpectrumPane"
                    Background="{DynamicResource AppPanelBackgroundBrush}">
                <spectrum:SpectrumChartView DataContext="{Binding Spectrum}" />
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="1"
                    Name="SignalPane"
                    Width="{x:Static spectrum:SpectrumPanel.PaneWidth}"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    BorderThickness="1,0,0,0"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Padding="16,12">
                <ScrollViewer Name="SidePaneScroll"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <spectrum:SpectrumPanel DataContext="{Binding Spectrum}" />
                </ScrollViewer>
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Name="TrendPane"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource AppBorderBrush}">
                <trend:TrendChartView DataContext="{Binding Trend}" />
            </Border>

            <Border Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Name="OverviewPane"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource AppBorderBrush}">
                <trend:OverviewView DataContext="{Binding Trend.Overview}" />
            </Border>

        </Grid>

        <Border Grid.Row="3"
                Name="MessagePanel"
                Height="{x:Static local:MainWindow.MessagePanelHeight}"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Padding="16,8"
                IsVisible="{Binding MessagePanel.IsVisible}">
            <messages:MessagePanelView DataContext="{Binding MessagePanel}" />
        </Border>

        <Border Grid.Row="4"
                Name="StatusBar"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Padding="16,8">
            <local:AppStatusBar DataContext="{Binding StatusBar}" />
        </Border>

    </Grid>

</Window>
