[
  {
    "label": "Build",
    "command": "dotnet",
    "args": ["build", "SemiSpec.slnx"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "Run app",
    "command": "dotnet",
    "args": ["run", "--project", "SemiSpec/SemiSpec.UI"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": true
  },
  {
    "label": "Run board emulator",
    "command": "dotnet",
    "args": [
      "run",
      "--project",
      "SemiSpec/SemiSpec.Tools.BoardEmulator",
      "--",
      "--port",
      "COM4",
      "--device",
      "2000",
      "--rate",
      "2"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": true
  },
  {
    "label": "Run emulator + app",
    "command": "pwsh",
    "args": [
      "-NoProfile",
      "-Command",
      "dotnet build SemiSpec.slnx; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; $bin = 'SemiSpec/Artifacts/bin'; Start-Process \"$bin/SemiSpec.UI/debug/SemiSpec.exe\"; & \"$bin/SemiSpec.Tools.BoardEmulator/debug/SemiSpec.Tools.BoardEmulator.exe\" --port COM4 --device 2000 --rate 2"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "Test All",
    "command": "dotnet",
    "args": ["test", "SemiSpec.slnx"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Test Current File",
    "command": "dotnet",
    "args": [
      "test",
      "SemiSpec/SemiSpec.Tests.Unit/SemiSpec.Tests.Unit.csproj",
      "--filter",
      "FullyQualifiedName~$ZED_STEM"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "format",
    "command": "dotnet",
    "args": ["format", "SemiSpec.slnx"],
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
