root = true

# Text files outside SemiSpec/, which has its own root .editorconfig.
# Line endings follow .gitattributes: native under text=auto, LF where it sets eol=lf.
[*]
charset = utf-8
insert_final_newline = true

[{*.slnx,global.json,nuget.config,.config/**,.githooks/**}]
end_of_line = lf

[{*.yml,*.yaml}]
indent_style = space
indent_size = 2

[*.md]
max_line_length = 120
