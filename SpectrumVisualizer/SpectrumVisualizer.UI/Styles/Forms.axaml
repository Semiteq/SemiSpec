<!-- docs/architecture/ui-theme.md#a-form-never-resizes-on-validation -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="TextBox.invalid /template/ Border#PART_ContentPresenterBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AppSeverityErrorBrush}" />
    </Style>

    <Style Selector=".invalid-glyph TextBox.invalid">
        <Setter Property="InnerRightContent">
            <Template>
                <PathIcon Width="16"
                          Height="16"
                          Margin="0,0,8,0"
                          Data="{StaticResource WarningGeometry}"
                          Foreground="{DynamicResource AppSeverityErrorBrush}" />
            </Template>
        </Setter>
    </Style>

    <Style Selector="NumericUpDown.invalid /template/ TextBox#PART_TextBox /template/ Border#PART_ContentPresenterBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AppSeverityErrorBrush}" />
    </Style>

    <Style Selector="CalendarDatePicker.invalid /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource AppSeverityErrorBrush}" />
    </Style>

    <Style Selector="TextBlock.form-message">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Height" Value="40" />
    </Style>

    <Style Selector="TextBlock.form-message.error">
        <Setter Property="Foreground" Value="{DynamicResource AppSeverityErrorBrush}" />
    </Style>

</Styles>
