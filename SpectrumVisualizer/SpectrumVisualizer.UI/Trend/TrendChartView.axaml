<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:scottplot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             xmlns:local="clr-namespace:SpectrumVisualizer.UI.Trend"
             xmlns:text="clr-namespace:SpectrumVisualizer.UI.Localization"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="300"
             x:Class="SpectrumVisualizer.UI.Trend.TrendChartView"
             x:DataType="local:TrendViewModel">

    <Panel>
        <Decorator Name="PlotLayer">
            <Decorator.CacheMode>
                <BitmapCache />
            </Decorator.CacheMode>
            <scottplot:AvaPlot Name="PlotControl" />
        </Decorator>
        <TextBlock Name="EmptyStateMessage"
                   Text="{x:Static text:Resources.TrendEmpty}"
                   IsVisible="{Binding !Chart.HasPoints, FallbackValue=False}"
                   IsHitTestVisible="False"
                   Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                   TextWrapping="Wrap"
                   MaxWidth="480"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        <Canvas Name="CursorOverlay" IsHitTestVisible="False">
            <Line Name="CrosshairLine"
                  IsVisible="False"
                  Stroke="{DynamicResource AppSecondaryForegroundBrush}"
                  StrokeThickness="1" />
            <Border Name="ReadoutBox"
                    IsVisible="False"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    Padding="4">
                <TextBlock Name="ReadoutText"
                           FontSize="12" />
            </Border>
        </Canvas>
    </Panel>

</UserControl>
