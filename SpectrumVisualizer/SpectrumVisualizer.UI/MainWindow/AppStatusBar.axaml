<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SpectrumVisualizer.UI.MainWindow"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="32"
             x:Class="SpectrumVisualizer.UI.MainWindow.AppStatusBar"
             x:DataType="local:AppStatusBarViewModel">

    <TextBlock Name="ConnectionText"
               Text="{Binding ConnectionText}"
               VerticalAlignment="Center" />

</UserControl>
