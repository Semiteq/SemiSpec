<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SpectrumVisualizer.UI.MainWindow"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="32"
             x:Class="SpectrumVisualizer.UI.MainWindow.AppStatusBar"
             x:DataType="local:AppStatusBarViewModel">

    <UserControl.Styles>
        <Style Selector="Ellipse.tone-neutral">
            <Setter Property="Fill" Value="{DynamicResource AppSecondaryForegroundBrush}" />
        </Style>
        <Style Selector="Ellipse.tone-ok">
            <Setter Property="Fill" Value="{DynamicResource AppConnectionOkBrush}" />
        </Style>
        <Style Selector="Ellipse.tone-fault">
            <Setter Property="Fill" Value="{DynamicResource AppConnectionFaultBrush}" />
        </Style>
        <Style Selector="Border.separator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Background" Value="{DynamicResource AppSubtleLineBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
          HorizontalAlignment="Left">

        <Ellipse Grid.Column="0"
                 Name="LinkDot"
                 Width="8"
                 Height="8"
                 Margin="0,0,8,0"
                 VerticalAlignment="Center"
                 Classes.tone-neutral="{Binding LinkTone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static local:LinkTone.Neutral}}"
                 Classes.tone-ok="{Binding LinkTone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static local:LinkTone.Ok}}"
                 Classes.tone-fault="{Binding LinkTone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static local:LinkTone.Fault}}" />

        <TextBlock Grid.Column="1"
                   Name="LinkText"
                   Text="{Binding LinkText}"
                   VerticalAlignment="Center" />

        <Border Grid.Column="2"
                Classes="separator" />

        <TextBlock Grid.Column="3"
                   Name="PortText"
                   Text="{Binding PortText}"
                   VerticalAlignment="Center" />

        <Border Grid.Column="4"
                Classes="separator" />

        <TextBlock Grid.Column="5"
                   Name="Atp2000Text"
                   Text="{Binding Atp2000Text}"
                   VerticalAlignment="Center" />

        <Border Grid.Column="6"
                Classes="separator" />

        <TextBlock Grid.Column="7"
                   Name="Atp8000Text"
                   Text="{Binding Atp8000Text}"
                   VerticalAlignment="Center" />

        <Border Grid.Column="8"
                Classes="separator" />

        <TextBlock Grid.Column="9"
                   Name="LostSpectraText"
                   Text="{Binding LostSpectraText}"
                   VerticalAlignment="Center" />

    </Grid>

</UserControl>
