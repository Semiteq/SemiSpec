<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:scottplot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             xmlns:local="clr-namespace:SpectrumVisualizer.UI.Spectrum"
             xmlns:text="clr-namespace:SpectrumVisualizer.UI.Localization"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="600"
             x:Class="SpectrumVisualizer.UI.Spectrum.SpectrumChartView"
             x:DataType="local:SpectrumChartViewModel">

    <Panel>
        <Decorator Name="PlotLayer">
            <Decorator.CacheMode>
                <BitmapCache />
            </Decorator.CacheMode>
            <scottplot:AvaPlot Name="PlotControl" />
        </Decorator>
        <TextBlock Name="EmptyStateMessage"
                   Text="{x:Static text:Resources.SpectrumEmpty}"
                   IsVisible="{Binding !HasSpectrum, FallbackValue=False}"
                   IsHitTestVisible="False"
                   Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                   TextWrapping="Wrap"
                   MaxWidth="480"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        <TextBlock Name="HistoricalLine"
                   Text="{Binding HistoricalText}"
                   IsVisible="{Binding HistoricalText, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"
                   IsHitTestVisible="False"
                   Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                   TextWrapping="NoWrap"
                   Margin="0,8,0,0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top" />
    </Panel>

</UserControl>
